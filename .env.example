# ============================================================================
# EXAM SOLVER AI — variáveis de ambiente
# Copiar para `.env.local` (desenvolvimento) e configurar na Vercel (produção).
# NUNCA versionar valores reais. `.env*.local` já está no .gitignore.
# ============================================================================

# ── Supabase (obrigatório) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca expor com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── IA (obrigatório) ────────────────────────────────────────────────────────
CEREBRAS_API_KEY=

# ── Administração (obrigatório para o painel) ───────────────────────────────
# Lista separada por vírgulas. Sem estes valores, NINGUÉM é administrador
# (falha fechada deliberada). Os antigos UUIDs/e-mail fixos no código foram
# removidos: este é agora o único ponto de configuração.
ADMIN_USER_ID=
ADMIN_EMAILS=

# ── Pagamentos (obrigatório para cartão) ────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Endpoint: https://<domínio>/api/webhooks/stripe
# Eventos: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# ── Opcional ────────────────────────────────────────────────────────────────
# Segredo dedicado para assinar a quota de convidado. Se ausente, é derivado
# de SUPABASE_SERVICE_ROLE_KEY (funciona, mas um segredo próprio é preferível).
GUEST_QUOTA_SECRET=
# Domínio público usado nos redirects de checkout.
NEXT_PUBLIC_SITE_URL=
# Liga o diagnóstico /api/system-check-ai em produção (só administradores).
ENABLE_SYSTEM_CHECK=false
